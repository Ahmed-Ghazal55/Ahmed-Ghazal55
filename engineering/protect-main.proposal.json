{
  "name": "protect-main",
  "target": "branch",
  "enforcement": "disabled",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "require_extra_approval_for_unattributed_changes": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          {"context": "ci-guard-regressions", "integration_id": 15368},
          {"context": "hygiene-smoke / inventory", "integration_id": 15368},
          {"context": "node-smoke / verify-node", "integration_id": 15368},
          {"context": "dotnet-smoke / verify-dotnet", "integration_id": 15368},
          {"context": "static-smoke / check-static", "integration_id": 15368},
          {"context": "CodeQL (javascript-typescript)", "integration_id": 15368},
          {"context": "CodeQL (csharp)", "integration_id": 15368}
        ]
      }
    }
  ]
}
